# Copy to .env and fill in. These override config.yaml.

# wire-pod: Cloak pulls the robot's serial, IP, token and cert from here. That's all you need.
WIREPOD_URL=http://escapepod.local:8080

# Optional overrides (only if you run several bots or discovery fails)
# VECTOR_SERIAL=00e20100
# VECTOR_IP=192.168.1.50
# VECTOR_GUID=
# VECTOR_NAME=Vector-A1B2

# LLM: any OpenAI-compatible endpoint (Cloak, Ollama, LM Studio, OpenAI...)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.2:3b

# TTS_ENGINE=kokoro
# WEB_HOST=127.0.0.1
# WEB_PORT=8765
# DATA_DIR=data
